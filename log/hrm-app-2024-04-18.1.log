        e.manager  
    FROM
        Employee e  
    INNER JOIN
        personal p 
            ON e.candidate_id = p.candidate_id  
    INNER JOIN
        personal_details pd 
            ON p.pdid = pd.pdid  
    INNER JOIN
        document_details dd 
            ON p.doc_id = dd.doc_id  
