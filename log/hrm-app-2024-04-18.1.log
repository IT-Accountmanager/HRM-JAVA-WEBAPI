    document_details dd ON p.doc_id = dd.doc_id
INNER JOIN
    bank_details bd ON p.bank_det_id = bd.id
INNER JOIN
    (SELECT
         candidate_id,
         MAX(end_date) AS max_end_date
     FROM
         education
     GROUP BY
         candidate_id
    ) max_edu ON p.candidate_id = max_edu.candidate_id
INNER JOIN
    education ed ON p.candidate_id = ed.candidate_id AND ed.end_date = max_edu.max_end_date LEFT JOIN
    Employee m ON e.manager = m.employee_id;) : {
}
