    SELECT
        e.employee_id,
        e.name AS employee_name,
        e.employee_status,
        e.employee_category,
        e.contact_number,
        e.email_id,
        e.date_of_joining,
        e.department,
        e.sub_department,
        m.name AS manager_name,
        e.designation,
        e.category_control,
        e.total_experience,
        e.joined_ctc,
        e.current_ctc,
        e.service_commitment,
        e.number_of_working_days,
        e.next_apprisal_quater,
        pd.date_of_birth,
        pd.blood_group,
        pd.fathers_name,
        dd.adhar_card_no,
        dd.pan_card_no,
        e.uan_number,
        bd.account_no,
        e.resignation_date,
        e.last_working_day,
        ed.qualification,
        ed.end_date,
        ed.stream,
        e.candidate_id,
        e.manager  
    FROM
        Employee e  
    INNER JOIN
        personal p 
            ON e.candidate_id = p.candidate_id  
    INNER JOIN
        personal_details pd 
            ON p.pdid = pd.pdid  
    INNER JOIN
        document_details dd 
            ON p.doc_id = dd.doc_id  
    INNER JOIN
        bank_details bd 
            ON p.bank_det_id = bd.id  
    INNER JOIN
